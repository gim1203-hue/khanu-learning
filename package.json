{
  "name": "khanu-learning-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Khanu AI tutoring and appointment booking platform",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend/src/dev.js",
    "dev:web": "vite frontend --config frontend/vite.config.js",
    "build": "vite build frontend --config frontend/vite.config.js",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node backend/src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2", "cors": "^2.8.5", "dotenv": "^16.6.1",
    "express": "^5.1.0", "express-rate-limit": "^8.1.0", "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2", "lucide-react": "^0.468.0", "mongoose": "^8.18.0",
    "react": "^19.1.1", "react-dom": "^19.1.1", "react-router-dom": "^7.9.1", "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2", "concurrently": "^9.2.1", "supertest": "^7.1.4", "vite": "^7.1.5"
  },
  "engines": { "node": ">=20" }
}
